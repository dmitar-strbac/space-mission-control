{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "safety-recommendation.schema.json",
  "title": "Safety Recommendation",
  "description": "Payload shared by safety corrective maneuver, return and abort recommendation events.",
  "type": "object",
  "required": [
    "mission_id",
    "alert_id",
    "reason",
    "severity"
  ],
  "properties": {
    "mission_id": {
      "type": "string",
      "format": "uuid"
    },
    "alert_id": {
      "type": "string",
      "format": "uuid"
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "severity": {
      "type": "string",
      "enum": [
        "INFO",
        "CAUTION",
        "WARNING",
        "CRITICAL"
      ]
    }
  },
  "additionalProperties": false
}

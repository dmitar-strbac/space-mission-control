{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "telemetry-alert-created.schema.json",
  "title": "Telemetry Alert Created",
  "type": "object",
  "required": [
    "id",
    "mission_id",
    "alert_type",
    "severity",
    "message",
    "measured_value",
    "threshold",
    "created_at",
    "last_seen_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "mission_id": {
      "type": "string",
      "format": "uuid"
    },
    "alert_type": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "INFO",
        "CAUTION",
        "WARNING",
        "CRITICAL"
      ]
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "measured_value": {
      "type": [
        "number",
        "string"
      ]
    },
    "threshold": {
      "type": [
        "number",
        "string"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_seen_at": {
      "type": "string",
      "format": "date-time"
    },
    "resolved_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "telemetry-processed.schema.json",
  "title": "Telemetry Processed",
  "description": "Processed mission telemetry derived from simulation state.",
  "type": "object",
  "required": [
    "mission_id",
    "simulation_session_id",
    "simulation_time_s",
    "recorded_at",
    "navigation",
    "propulsion",
    "life_support",
    "power"
  ],
  "properties": {
    "mission_id": {
      "type": "string",
      "format": "uuid"
    },
    "simulation_session_id": {
      "type": "string",
      "format": "uuid"
    },
    "simulation_time_s": {
      "type": "number",
      "minimum": 0
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "navigation": {
      "type": "object"
    },
    "propulsion": {
      "type": "object"
    },
    "life_support": {
      "type": "object"
    },
    "power": {
      "type": "object"
    },
    "communication": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
